# ==========================================
# CẤU HÌNH KẾT NỐI JIRA & REDMINE (TÙY CHỌN)
# ==========================================
# Sao chép file này thành .env và điền thông tin của dự án bạn.
# Nếu không cấu hình .env, hệ thống sẽ tự động xuất file CSV chuẩn 
# (export_jira_xray.csv / export_redmine.csv) để bạn import thủ công qua giao diện web.

# 1. Jira Cloud / Jira Server
JIRA_HOST=https://your-domain.atlassian.net
JIRA_EMAIL=qa-lead@shopgo.vn
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=SHOPGO
JIRA_TEST_ISSUE_TYPE=Test

# 2. Redmine (nếu sử dụng Redmine)
REDMINE_HOST=https://redmine.your-company.com
REDMINE_API_KEY=your_redmine_api_key_here
REDMINE_PROJECT_ID=shopgo
